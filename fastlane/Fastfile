default_platform(:android)

platform :android do
  desc "Validate the Google Play service-account key (no upload)"
  lane :validate do
    validate_play_store_json_key(json_key: "google-play-key.json")
  end

  desc "Upload the latest signed AAB to Google Play production — full rollout (all users)"
  lane :release do
    upload_to_play_store(
      track: "production",
      release_status: "completed",          # full release, not a draft/staged hold
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      # We only ship the binary here — leave the existing store listing untouched.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
