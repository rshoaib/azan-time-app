<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Present in the merged manifest already via expo-notifications, but a
       library must declare what it actually uses. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Required from API 34 for a mediaPlayback foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <application>
    <service
      android:name="expo.modules.adhanplayback.AdhanPlaybackService"
      android:foregroundServiceType="mediaPlayback"
      android:exported="false"
      android:stopWithTask="false" />

    <receiver
      android:name="expo.modules.adhanplayback.AdhanAlarmReceiver"
      android:exported="false" />

    <!-- Re-arms alarms after reboot / app update. Must be exported="false" but
         still receives these protected system broadcasts. -->
    <receiver
      android:name="expo.modules.adhanplayback.AdhanBootReceiver"
      android:exported="false"
      android:enabled="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
